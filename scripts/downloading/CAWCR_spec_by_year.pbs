#!/bin/bash
#PBS -P gv90
#PBS -q hugemembw
#PBS -l ncpus=7
#PBS -l mem=256GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/gv90+gdata/xp65+gdata/ik11+gdata/vk83
#PBS -l wd
#PBS -j oe
#PBS -r y
#PBS -N cawcr_wave
#PBS -J 1-3

set -euo pipefail

YEAR="${YEAR:?YEAR not set}"
MONTH=$(printf "%02d" "${PBS_ARRAY_INDEX}")

PY_SCRIPT="/home/581/da1339/AFIM/src/AFIM/scripts/downloading/CAWCR_spec_by_month.py"
OUTDIR="/g/data/gv90/da1339/afim_input/CAWCR"
OUTFILE="${OUTDIR}/CAWCR_efreq_for_CICE6_${YEAR}${MONTH}.nc"

echo "YEAR=${YEAR}"
echo "MONTH=${MONTH}"
echo "HOST=$(hostname)"
echo "START=$(date)"

if [[ -s "${OUTFILE}" ]]; then
    echo "Output exists, skipping: ${OUTFILE}"
    exit 0
fi

module use /g/data/xp65/public/modules
module load conda/analysis3-26.03

python "${PY_SCRIPT}" "${YEAR}" "${MONTH}"

echo "END=$(date)"
